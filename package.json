{
  "name": "@theoparashkevov/opencode-talk",
  "version": "1.0.12",
  "description": "Voice-to-text plugin for opencode — toggle recording, transcribe with OpenAI Whisper, inject into TUI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theoparashkevov/opencode-talk.git"
  },
  "bugs": {
    "url": "https://github.com/theoparashkevov/opencode-talk/issues"
  },
  "homepage": "https://github.com/theoparashkevov/opencode-talk#readme",
  "scripts": {
    "build": "tsc",
    "bundle": "bun build ./index.js --outfile=dist/index.js --target=bun --format=esm",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run bundle"
  },
  "keywords": [
    "opencode",
    "voice",
    "whisper",
    "speech-to-text",
    "plugin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "openai": "^4.52.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/plugin": {
      "optional": true
    }
  }
}
